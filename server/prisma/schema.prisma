generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
}

// Phase 1: meetings are anonymous. hostId → User arrives with accounts in Phase 4.
model Meeting {
  id           String        @id @default(cuid())
  title        String
  roomCode     String        @unique
  status       MeetingStatus @default(SCHEDULED)
  createdAt    DateTime      @default(now())
  startedAt    DateTime?
  endedAt      DateTime?
  // Secret given only to the creator's browser; needed to end the meeting for everyone. Accounts replace this in Phase 4.
  hostKey      String        @default("")
  hostId       String?
  host         User?         @relation("HostedMeetings", fields: [hostId], references: [id], onDelete: SetNull)
  // Host controls: "Ask to join" (people wait until the host lets them in) and lock (nobody new can join)
  waitingRoom  Boolean       @default(false)
  locked       Boolean       @default(false)
  // Scheduled meetings: start time (UTC) and planned length; invites go to these emails
  scheduledFor DateTime?
  durationMin  Int?
  invites      Invite[]
  // Host cancelled it before it started (guests got a cancellation); hidden from lists, link says so
  cancelledAt  DateTime?
  // Calendar invite version: bumped on every change so calendars update the same event instead of adding one
  inviteSequence Int     @default(0)
  // Reminder email ("starts in 10 minutes") went out at this time
  reminderSentAt DateTime?
  // Recurring meetings: every occurrence is its own meeting (own link, notes) sharing one seriesId
  seriesId     String?
  recurrence   String?       // "DAILY" | "WEEKLY"
  // Team meeting: every team member can see it and its notes; the team's settings apply
  teamId       String?
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  questions    AiQuestion[]
  participants Participant[]
  chat         ChatMessage[]
  transcript   Transcript[]
  notes        Notes?
  recordings   Recording[]

  @@index([seriesId])
  @@index([teamId])
  @@index([status, scheduledFor])
}

model Participant {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  joinedAt  DateTime @default(now())
  lines     Transcript[]
  messages  ChatMessage[]
  status    ParticipantStatus @default(ADMITTED)
  isHost    Boolean  @default(false)
  // Secret the waiting person's browser uses to ask "am I in yet?"; seenAt = last time it asked
  ticket    String?
  seenAt    DateTime?

  @@index([meetingId])
  @@index([userId])
}

// One finished caption line. Written by the speaker's own browser (Phase 2); used for AI notes (Phase 3).
model Transcript {
  id            String      @id @default(cuid())
  meetingId     String
  meeting       Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  speakerName   String
  text          String
  spokenAt      DateTime

  @@index([meetingId, spokenAt])
}

enum NotesStatus {
  PENDING
  READY
  FAILED
  EMPTY // nothing was transcribed, so there is nothing to summarize
}

// AI meeting notes (Phase 3). Lists are JSON arrays; actionItems = [{ task, owner, dueDate }].
model Notes {
  id            String      @id @default(cuid())
  meetingId     String      @unique
  meeting       Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  status        NotesStatus @default(PENDING)
  title         String      @default("")
  summary       String      @default("")
  keyPoints     Json        @default("[]")
  decisions     Json        @default("[]")
  actionItems   Json        @default("[]")
  openQuestions Json        @default("[]")
  provider      String?
  error         String?
  edited        Boolean     @default(false)
  emailedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// Phase 4 accounts. Password is hashed with scrypt (never stored as text). Google-only accounts have no password.
model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String?
  googleId     String?       @unique
  // Profile photo: a small image (≤ 200 KB, resized in the browser) stored right here. Version busts caches.
  avatar        Bytes?
  avatarType    String?
  avatarVersion Int          @default(0)
  // Photo from Google, used when no photo was uploaded.
  pictureUrl    String?
  // Bumped on password change/reset: sessions carry this number, so older sessions on other devices stop working.
  sessionVersion Int         @default(0)
  // Set once the person clicks the link in the confirmation email (or signs in with Google, or resets the password).
  emailVerifiedAt DateTime?
  // "FREE" | "PRO" (limits in services/plan.service.ts; no payments yet, set with scripts/set-plan.ts)
  plan         String        @default("FREE")
  // Stripe (test mode for now): customer + the Pro subscription, kept in sync by webhook / on the Billing page
  stripeCustomerId   String?   @unique
  subscriptionId     String?
  subscriptionStatus String?   // Stripe status: active, trialing, past_due, canceled, ...
  planInterval       String?   // "month" | "year"
  planRenewsAt       DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  // Billing emails already sent, so each goes out once even when the webhook and a page sync both see it:
  // { receipt: <last invoice id>, cancel: <end timestamp>, failed: <invoice id>, ended: <subscription id> }
  billingEmails      Json      @default("{}")
  // Secret for the personal calendar feed (/api/calendar/<token>.ics); new token = old link stops working
  calendarToken String?      @unique
  createdAt    DateTime      @default(now())
  hosted       Meeting[]     @relation("HostedMeetings")
  joined       Participant[]
  resets       PasswordReset[]
  teams        TeamMember[]
  questions    AiQuestion[]
}

// "Forgot password" links. Only a SHA-256 hash of the token is stored; links expire and work once.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum RecordingStatus {
  UPLOADING
  READY
  FAILED
}

// A recording made in the host's browser and uploaded straight to Backblaze B2 (the server never touches the video).
model Recording {
  id          String          @id @default(cuid())
  meetingId   String
  meeting     Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  storageKey  String          @unique
  mimeType    String
  sizeBytes   Int             @default(0)
  durationSec Int             @default(0)
  status      RecordingStatus @default(UPLOADING)
  createdAt   DateTime        @default(now())

  @@index([meetingId])
}

enum ParticipantStatus {
  ADMITTED
  WAITING
  DENIED
  REMOVED
}

/// Someone invited by email to a scheduled meeting (gets a calendar invite).
model Invite {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())
  // Guest's answer from the invite email: "YES" | "MAYBE" | "NO" (empty = no answer yet)
  response    String?
  respondedAt DateTime?

  @@unique([meetingId, email])
  @@index([email])
}

// In-call chat, kept with the meeting (shown on the notes page)
model ChatMessage {
  id            String      @id @default(cuid())
  meetingId     String
  meeting       Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  senderName    String
  text          String
  sentAt        DateTime    @default(now())

  @@index([meetingId, sentAt])
}

// "Ask AI" about one meeting: kept so the asker sees their questions again (and for the daily limit)
model AiQuestion {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  provider  String
  createdAt DateTime @default(now())

  @@index([meetingId, userId])
  @@index([userId, createdAt])
}

// A team shares meetings and notes; owners/admins change its settings and members
model Team {
  id             String       @id @default(cuid())
  name           String
  createdAt      DateTime     @default(now())
  // Admin settings: new team meetings start with "Ask to join"; only these email domains may join
  // team meetings (signed in, confirmed); who can record ("HOST" = the meeting's host, "OFF" = nobody)
  askToJoin      Boolean      @default(false)
  allowedDomains String[]     @default([])
  recording      String       @default("HOST")
  members        TeamMember[]
  invites        TeamInvite[]
  meetings       Meeting[]
}

model TeamMember {
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("MEMBER") // "OWNER" | "ADMIN" | "MEMBER"
  joinedAt DateTime @default(now())

  @@id([teamId, userId])
  @@index([userId])
}

// Waiting for someone with this email to accept (shown on their Teams page)
model TeamInvite {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email     String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  @@unique([teamId, email])
  @@index([email])
}
