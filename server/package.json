{
  "name": "meet-app-server",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc",
    "test": "node --env-file=.env scripts/test.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "build": "esbuild src/app.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/app.js --log-level=warning",
    "db:deploy:prod": "node --env-file=.env scripts/migrate-prod.mjs",
    "seed:demo": "tsx --env-file=.env scripts/seed-demo.ts"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@upstash/redis": "^1.41.0",
    "@vercel/functions": "^3.11.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "livekit-server-sdk": "^2.19.3",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
