NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
# Your local PostgreSQL (development). On Vercel this is Neon's POOLED connection string (host has "-pooler").
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/meetapp?schema=public
# Neon only (on Vercel): the DIRECT connection string, used for migrations. Leave empty locally.
DIRECT_DATABASE_URL=

# Tests (npm test) use their OWN local database; it is emptied/changed by tests. Create it once (see README).
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/meetapp_test?schema=public

# LIVE database (Neon), used only by `npm run db:deploy:prod` to update the live tables
PROD_DATABASE_URL=
PROD_DIRECT_DATABASE_URL=
# From your LiveKit Cloud project → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- AI meeting notes (Phase 3) ----
# Add at least one. The app tries them in this order: Mistral → Gemini → Groq → OpenRouter.
# Mistral: https://console.mistral.ai → API Keys (free "Experiment" plan).
#   Turn OFF "use my data for training" in Admin → Privacy.
MISTRAL_API_KEY=
# Gemini: https://aistudio.google.com/apikey (free plan; Google may use free-plan data)
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys (free plan)
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys (free models ending in ":free"; about 50 free requests/day)
#   In Settings → Privacy, check which providers may store or train on your prompts.
OPENROUTER_API_KEY=

# ---- Accounts (Phase 4) ----
# Long random secret that signs login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---- Shared rate limits (needed on Vercel; optional locally) ----
# https://console.upstash.com → Redis → Create database (free) → REST API section
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Email: forgot password + meeting notes (Nodemailer over SMTP) ----
# Leave SMTP_HOST empty locally to print emails in the server log instead of sending them.
# Gmail: turn on 2-Step Verification, then https://myaccount.google.com/apppasswords → create an
#   app password (16 letters) and use it as SMTP_PASS. Gmail sends up to ~500 emails/day.
SMTP_HOST=smtp.gmail.com
# 587 (STARTTLS) or 465 (TLS)
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=
# Sender shown to people; with Gmail it must be your Gmail address (or an alias you added in Gmail)
EMAIL_FROM=MeetApp <you@gmail.com>

# ---- Google sign-in (optional) ----
# Google Cloud Console → APIs & Services → Credentials → Create credentials → OAuth client ID
#   Application type: Web application
#   Authorized JavaScript origins: http://localhost:5173  (add your live site later)
#   (no redirect URI needed). Put the same Client ID in client/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# ---- Recordings (Phase 4): Backblaze B2 (free 10 GB) ----
# 1. https://www.backblaze.com → B2 Cloud Storage → Buckets → Create a Bucket
#    name e.g. meet-recordings-yourname, Files in bucket: PRIVATE
#    The bucket page shows the "Endpoint", e.g. s3.us-west-004.backblazeb2.com
# 2. Application Keys → Add a New Application Key
#    access: only this bucket, Read and Write. Copy keyID + applicationKey (shown once).
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# Endpoint from the bucket page, with https:// in front
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# The part after "s3." in the endpoint, e.g. us-west-004
B2_REGION=us-west-004

# Reminder emails ("starts in 10 minutes"). On Vercel, a free scheduler such as cron-job.org calls
# GET https://<your-app>/api/cron/reminders every 5 minutes with the header  Authorization: Bearer <CRON_SECRET>
# Make one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Locally the server sends reminders by itself every minute.
CRON_SECRET=
