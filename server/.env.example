NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://meet:meet@localhost:5433/meetapp?schema=public
# From your LiveKit Cloud project → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- AI meeting notes (Phase 3) ----
# Add at least one. The app tries them in this order: Mistral → Gemini → Groq → OpenRouter.
# Mistral: https://console.mistral.ai → API Keys (free "Experiment" plan).
#   Turn OFF "use my data for training" in Admin → Privacy.
MISTRAL_API_KEY=
# Gemini: https://aistudio.google.com/apikey (free plan; Google may use free-plan data)
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys (free plan)
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys (free models ending in ":free"; about 50 free requests/day)
#   In Settings → Privacy, check which providers may store or train on your prompts.
OPENROUTER_API_KEY=

# ---- Accounts (Phase 4) ----
# Long random secret that signs login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---- Google sign-in (optional) ----
# Google Cloud Console → APIs & Services → Credentials → Create credentials → OAuth client ID
#   Application type: Web application
#   Authorized JavaScript origins: http://localhost:5173  (add your live site later)
#   (no redirect URI needed). Put the same Client ID in client/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# ---- Recordings (Phase 4): Backblaze B2 (free 10 GB) ----
# 1. https://www.backblaze.com → B2 Cloud Storage → Buckets → Create a Bucket
#    name e.g. meet-recordings-yourname, Files in bucket: PRIVATE
#    The bucket page shows the "Endpoint", e.g. s3.us-west-004.backblazeb2.com
# 2. Application Keys → Add a New Application Key
#    access: only this bucket, Read and Write. Copy keyID + applicationKey (shown once).
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# Endpoint from the bucket page, with https:// in front
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# The part after "s3." in the endpoint, e.g. us-west-004
B2_REGION=us-west-004
